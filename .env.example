# ThermoWatch AI — environment configuration
# Copy this file to `.env` and fill in whichever keys you have.
# The app runs with NONE of these set — it will just report "no key configured"
# in the status/log panel for any branch/provider that needs one.

# ---------------------------------------------------------------------------
# NASA FIRMS — thermal hotspot detections (fire/thermal anomaly points)
# Free instant API key, no approval wait: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Docs: https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# ---------------------------------------------------------------------------
# Google Gemini — primary vision/reasoning engine for Branch A (Vision)
# Free tier key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Groq — fast free-tier inference, Llama-family models (ensemble provider)
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-90b-vision-preview

# ---------------------------------------------------------------------------
# OpenRouter — aggregator exposing several free-tier models (ensemble provider)
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ---------------------------------------------------------------------------
# No key needed for these (kept here for documentation / future overrides):
#   - OpenStreetMap Overpass API      https://overpass-api.de/
#   - NASA POWER                      https://power.larc.nasa.gov/
#   - Esri World Imagery              https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer
#   - EOX Sentinel-2 Cloudless        https://tiles.maps.eox.at/
#   - Leaflet.js + OpenStreetMap tiles

# ---------------------------------------------------------------------------
# Future / optional — Google Earth Engine (pending approval, NOT a hard
# dependency anywhere in this build). Leave blank until available.
GEE_SERVICE_ACCOUNT_JSON=

# App config
DATABASE_PATH=data/thermowatch.db
IMAGE_CACHE_DIR=data/cache/images
LOG_LEVEL=INFO
